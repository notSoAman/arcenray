{
  "rules": [
    {
      "allowed": {
        "origins": [
          "http://localhost:3000",
          "https://arcenray.com",
          "https://www.arcenray.com"
        ],
        "methods": ["PUT", "GET", "HEAD"],
        "headers": ["Content-Type", "Content-Length", "If-Match", "Range"]
      },
      "exposeHeaders": ["ETag", "Content-Length", "Content-Range"],
      "maxAgeSeconds": 3600
    }
  ]
}
