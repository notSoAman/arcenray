{
  "expo": {
    "name": "Arcenray",
    "slug": "arcenray",
    "owner": "notsoamans-team",
    "scheme": "arcenray-dev",
    "version": "0.1.0",
    "platforms": ["android"],
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.arcenray.mobile.dev",
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "@clerk/expo",
      "expo-dev-client",
      "expo-video",
      [
        "expo-image-picker",
        { "cameraPermission": false, "microphonePermission": false }
      ]
    ],
    "experiments": { "typedRoutes": true },
    "extra": { "eas": { "projectId": "68a21561-8def-4dff-b6b8-e686e7c3a2c4" } }
  }
}
