{
  "expo": {
    "name": "Arcenray",
    "slug": "arcenray",
    "owner": "notsoamans-team",
    "scheme": "arcenray-dev",
    "version": "0.1.0",
    "platforms": ["android"],
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.arcenray.mobile.dev",
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0F0E",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      "expo-router",
      "expo-font",
      "expo-asset",
      "expo-status-bar",
      "expo-secure-store",
      "expo-web-browser",
      "@clerk/expo",
      "@clerk/expo-google-signin",
      "expo-dev-client",
      "expo-video",
      [
        "expo-image-picker",
        {
          "cameraPermission": false,
          "microphonePermission": "Allow Arcenray to record voice notes you choose to send."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Arcenray to record voice notes you choose to send.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "68a21561-8def-4dff-b6b8-e686e7c3a2c4"
      },
      "EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID": "456443622037-s6nb9t4i0d5634lkp3ilrc81meq6disi.apps.googleusercontent.com"
    }
  }
}
