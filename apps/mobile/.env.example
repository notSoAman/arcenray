# Public configuration only. EXPO_PUBLIC values are embedded in the app.
# Clerk pk_test_ or pk_live_ must match the intended trusted instance.
# Leave blank for a configuration screen; there is no fake catalog or session.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_MEDIA_URL=
# Public OAuth client ID used by native Google Credential Manager sign-in.
EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID=

# Optional Android Firebase client configuration file used by native builds with push.
# ARCENRAY_ANDROID_GOOGLE_SERVICES_FILE=./google-services.json
