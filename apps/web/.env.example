# Public project URL + publishable key only; never put secret/service-role keys here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-publishable-or-anon-key
NEXT_PUBLIC_MEDIA_URL=https://cdn.example.com

# Clerk development application; obtain these from the founder securely.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Server-only. Never prefix this with NEXT_PUBLIC_ or commit a real value.
CLERK_SECRET_KEY=sk_test_replace_me

# Server-only account deletion and verified Clerk user.deleted webhook.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-development-service-key
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_WEBHOOK_SIGNING_SECRET=your-selected-instance-webhook-signing-secret
# Monitored public mailbox. Required before public launch.
SUPPORT_EMAIL=
