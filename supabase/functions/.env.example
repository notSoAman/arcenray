# Server-side only. Set real values using supabase secrets set --env-file <ignored file>.
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-bucket-scoped-access-key
R2_SECRET_ACCESS_KEY=your-bucket-scoped-secret
R2_BUCKET_NAME=arcenray-media
R2_UPLOAD_BUCKET_NAME=arcenray-uploads
R2_PUBLIC_URL=https://cdn.arcenray.com
ALLOWED_ORIGINS=http://localhost:3000,https://arcenray.com,https://www.arcenray.com

# Managed operations credential; must match encrypted Vault arcenray_cleanup_secret.
CLEANUP_SECRET=generate-a-random-server-only-value
