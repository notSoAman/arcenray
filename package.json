{
  "name": "arcenray",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "setup:web": "node scripts/setup-web.mjs",
    "test": "pnpm --filter @repo/shared test && node --experimental-strip-types --test supabase/functions/_shared/media-inspection.test.ts && pnpm --filter web test",
    "backend:types": "node scripts/generate-db-types.mjs",
    "backend:smoke": "node scripts/run-backend-smoke.mjs",
    "test:browser-media": "node scripts/check-browser-media.mjs",
    "backend:auth-check": "node scripts/check-auth-boundaries.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "supabase": "^2.121.0",
    "turbo": "^2.11.8",
    "typescript": "7.0.2",
    "wrangler": "^4.151.0"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
